<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AbletonMulti.App"
        x:Class="AbletonMulti.App.MainWindow"
        Title="AbletonMulti — 共同編集チェッカー"
        Width="1100" Height="780" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Window.DataTemplates>
        <DataTemplate x:DataType="local:Pill">
            <Border Classes="pill" Background="{Binding Background}">
                <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" />
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*">

        <!-- ヘッダー -->
        <Border Grid.Row="0" Padding="24,14" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardBorder}"
                Background="{DynamicResource CardBackground}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#FF764D">
                        <TextBlock Text="♪" Foreground="White" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="AbletonMulti" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="共同編集チェッカー" Classes="subtle" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="ScanStatus" Classes="subtle" FontSize="12"
                           VerticalAlignment="Center" Text="プラグインを検索中…" />
            </Grid>
        </Border>

        <!-- 最初の画面: ドロップ領域 -->
        <Grid Grid.Row="1" x:Name="EmptyView" Margin="32">
            <Rectangle x:Name="DropRect" RadiusX="18" RadiusY="18" StrokeDashArray="6,4">
                <Rectangle.Styles>
                    <Style Selector="Rectangle">
                        <Setter Property="Stroke" Value="{DynamicResource DropStroke}" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </Style>
                    <Style Selector="Rectangle.drag">
                        <Setter Property="Stroke" Value="#FF764D" />
                        <Setter Property="StrokeThickness" Value="3" />
                    </Style>
                </Rectangle.Styles>
            </Rectangle>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="520">
                <Border Width="72" Height="72" CornerRadius="20" Background="#26FF764D" HorizontalAlignment="Center">
                    <TextBlock Text="♪" FontSize="36" Foreground="#FF764D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Ableton のプロジェクトをここにドラッグ" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Classes="subtle" TextWrapping="Wrap" TextAlignment="Center" FontSize="14"
                           Text=".als ファイルを読み込んで、他の人と共有する前に直すべきところ（プロジェクト外のサンプル、足りないプラグインなど）をチェックします。" />
                <Button x:Name="OpenButton" Classes="accent" HorizontalAlignment="Center" Padding="22,9"
                        FontSize="15" Content="ファイルを選ぶ…" Margin="0,8,0,0" />
                <TextBlock x:Name="ErrorText" Foreground="#E5484D" TextWrapping="Wrap" TextAlignment="Center" IsVisible="False" />
            </StackPanel>
        </Grid>

        <!-- 読み込み後の画面 -->
        <Grid Grid.Row="1" x:Name="ResultView" IsVisible="False" Margin="24,20,24,16" RowDefinitions="Auto,Auto,*">

            <!-- プロジェクト概要 -->
            <Border Grid.Row="0" Classes="card" Padding="20">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ProjectName" FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ProjectMeta" Classes="subtle" FontSize="14" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button x:Name="ExportButton" Content="マニフェストを書き出す" />
                        <Button x:Name="ReopenButton" Content="別のファイルを開く" />
                    </StackPanel>
                    <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" x:Name="Stats" Rows="1" Margin="0,16,0,0" />
                </Grid>
            </Border>

            <!-- 判定バナー -->
            <Border Grid.Row="1" x:Name="Verdict" CornerRadius="10" Padding="18,14" Margin="0,14,0,6" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*">
                    <Border x:Name="VerdictIcon" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Center">
                        <TextBlock x:Name="VerdictGlyph" Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="VerdictTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="VerdictDetail" Classes="subtle" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="2" x:Name="Tabs" Padding="0,8,0,0">
                <TabItem x:Name="IssuesTab" Header="チェック結果">
                    <ScrollViewer>
                        <ItemsControl x:Name="IssueList" Classes="list">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:IssueVm">
                                    <Border Classes="card" Padding="0" ClipToBounds="True">
                                        <Grid ColumnDefinitions="5,*">
                                            <Border Background="{Binding Accent}" />
                                            <StackPanel Grid.Column="1" Margin="16,14" Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <ContentControl Content="{Binding Badge}" />
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" Classes="subtle" TextWrapping="Wrap" FontSize="13.5" />
                                                <Border IsVisible="{Binding HasFix}" Background="{DynamicResource InsetBackground}"
                                                        CornerRadius="8" Padding="12,9">
                                                    <TextBlock TextWrapping="Wrap" FontSize="13.5">
                                                        <Run Text="直し方　" FontWeight="SemiBold" />
                                                        <Run Text="{Binding Fix}" />
                                                    </TextBlock>
                                                </Border>
                                                <Expander IsVisible="{Binding HasItems}" Header="{Binding ItemsHeader}"
                                                          HorizontalAlignment="Stretch">
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <SelectableTextBlock Text="{Binding}" Classes="mono" TextWrapping="Wrap" Margin="0,2" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="PluginsTab" Header="プラグイン">
                    <ScrollViewer>
                        <ItemsControl x:Name="PluginList" Classes="list">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:PluginVm">
                                    <Border Classes="card" Padding="16,12">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <ContentControl Content="{Binding Format}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Subtitle}" Classes="subtle" FontSize="13" />
                                                <TextBlock Text="{Binding Tracks}" Classes="subtle" FontSize="12.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ContentControl Grid.Column="2" Content="{Binding Status}" VerticalAlignment="Top"
                                                            ToolTip.Tip="{Binding InstalledPath}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="SamplesTab" Header="サンプル">
                    <ScrollViewer>
                        <ItemsControl x:Name="SampleList" Classes="list">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:FileVm">
                                    <Border Classes="card" Padding="16,11">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding FileName}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Folder}" Classes="subtle mono" TextTrimming="PrefixCharacterEllipsis" />
                                                <TextBlock Text="{Binding Tracks}" Classes="subtle" FontSize="12.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Size}" Classes="subtle" FontSize="13"
                                                       VerticalAlignment="Top" Margin="12,2" />
                                            <ContentControl Grid.Column="2" Content="{Binding Location}" VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="MaxTab" Header="Max for Live">
                    <ScrollViewer>
                        <ItemsControl x:Name="MaxList" Classes="list">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TracksTab" Header="トラック">
                    <ScrollViewer>
                        <ItemsControl x:Name="TrackList" Classes="list">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:TrackVm">
                                    <Border Classes="card" Padding="12,8" Margin="{Binding Indent}">
                                        <Grid ColumnDefinitions="64,Auto,*,Auto">
                                            <ContentControl Content="{Binding Kind}" HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Devices}" Classes="subtle" FontSize="12.5"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Stats}" Classes="subtle" FontSize="12.5"
                                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- ドラッグ中のオーバーレイ -->
            <Border Grid.RowSpan="3" x:Name="DropOverlay" IsVisible="False" CornerRadius="14"
                    Background="#D9FF764D" IsHitTestVisible="False">
                <TextBlock Text="ドロップして読み込む" FontSize="24" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- 下部のステータス -->
        <TextBlock Grid.Row="1" x:Name="Toast" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,24" Padding="16,8" Background="#E6202024" Foreground="White" FontSize="13" />
    </Grid>
</Window>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Maltese.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBackground" Color="#000000" />
                    <SolidColorBrush x:Key="CardBackground" Color="#000000" />
                    <SolidColorBrush x:Key="CardBorder" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="InsetBackground" Color="#000000" />
                    <SolidColorBrush x:Key="SubtleText" Color="#BDBDBD" />
                    <SolidColorBrush x:Key="DropStroke" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBackground" Color="#000000" />
                    <SolidColorBrush x:Key="CardBackground" Color="#000000" />
                    <SolidColorBrush x:Key="CardBorder" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="InsetBackground" Color="#000000" />
                    <SolidColorBrush x:Key="SubtleText" Color="#BDBDBD" />
                    <SolidColorBrush x:Key="DropStroke" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="AppFont">Segoe UI, Yu Gothic UI, Meiryo UI, Hiragino Sans, Hiragino Kaku Gothic ProN, Noto Sans CJK JP, Inter</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, Yu Gothic UI, Hiragino Sans, monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Background" Value="{DynamicResource PageBackground}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pill > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.subtle">
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- 黒地に白い細線だけを使う、角のないコントロール -->
        <Style Selector="Button">
            <Setter Property="Background" Value="#000000" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#BDBDBD" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Background" Value="#000000" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="BorderBrush" Value="#666666" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#000000" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#FFFFFF" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#000000" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="#000000" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <!-- スクロールバーがカードに重ならないよう右に余白 -->
        <Style Selector="ItemsControl.list">
            <Setter Property="Margin" Value="0,0,16,8" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
    </Application.Styles>
</Application>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Maltese.App"
        x:Class="Maltese.App.MainWindow"
        Title="Maltese"
        Width="1100" Height="780" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="24,14" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardBorder}"
                Background="{DynamicResource CardBackground}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="0" Background="#000000"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <TextBlock Text="♪" Foreground="White" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Maltese" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="LanguageLabel" Text="Language" VerticalAlignment="Center" />
                    <ComboBox x:Name="LanguageBox" Width="120" SelectedIndex="0">
                        <ComboBoxItem Content="English" />
                        <ComboBoxItem Content="日本語" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <local:SessionView Grid.Row="1" x:Name="SessionPage" />
    </Grid>
</Window>

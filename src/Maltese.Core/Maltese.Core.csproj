<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Live に入れる Remote Script をアプリに同梱する -->
  <ItemGroup>
    <EmbeddedResource Include="RemoteScript\Maltese\*.py" LogicalName="RemoteScript/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- REAPER に入れるスクリプト（Lua） -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\reaper\Maltese\*.lua" LogicalName="ReaperScript/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Bitwig に入れる拡張（bitwig/build.sh で作る。Bitwig の内部 API を使うので、Bitwig のある PC でビルドしてここに置く） -->
  <ItemGroup>
    <EmbeddedResource Include="BitwigExtension\Maltese.bwextension" LogicalName="BitwigExtension/Maltese.bwextension"
                      Condition="Exists('BitwigExtension\Maltese.bwextension')" />
  </ItemGroup>

</Project>
